# Required
OPENAI_API_KEY=sk-...

# Optional: provider:model string (used by create_agent + init_chat_model)
AGENT_MODEL=openai:gpt-4.1-mini

# Optional: outer improvement-loop settings
MAX_ITERATIONS=3
TARGET_PASS_RATE=0.9
RESET_TRACES=1

# Optional: LangSmith tracing for the local Agent Server / Studio
# LANGSMITH_API_KEY=ls-...
# LANGSMITH_TRACING=true
