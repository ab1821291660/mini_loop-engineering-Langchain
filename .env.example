base_url = https://api.deepseek.com
AGENT_MODEL = deepseek-v4-flash   # AGENT_MODEL = deepseek-v4-pro
OPENAI_API_KEY = sk-...

# Optional: outer improvement-loop settings
MAX_ITERATIONS=3
TARGET_PASS_RATE=0.9
RESET_TRACES=1

# Optional: LangSmith tracing for the local Agent Server / Studio
# LANGSMITH_API_KEY=ls-...
# LANGSMITH_TRACING=true
